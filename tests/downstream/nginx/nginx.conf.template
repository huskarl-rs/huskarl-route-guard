events {}
http {
    # A named upstream resolves when the configuration is loaded, without a
    # runtime DNS resolver despite the variable URI in proxy_pass.
    upstream origin { server ${UPSTREAM}:8080; }
    log_format paths '$request_method $request_uri -> $uri : $status';
    access_log /dev/stdout paths;
    error_log /dev/stderr warn;
    server {
        listen 8080;
        location / {
            # The runner selects the original request URI or normalized decoded
            # URI. Decoded forwarding deliberately adds no escaping.
            proxy_pass http://origin${FORWARD_TARGET};
            proxy_set_header Host localhost;
            proxy_http_version 1.0;
        }
    }
}
